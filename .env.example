# ---------------------------------------------------------------------------
# GPU Native Infra POC -- default configuration.
#
# Copy to .env (install.sh does it for you). Every default below runs the full
# demo with NO real infrastructure and NO secrets.
# ---------------------------------------------------------------------------

APP_NAME=GPU Native Infra POC

# --- execution mode --------------------------------------------------------
# simulation = the mock POC (./startpoc.sh)
# mvp        = real local kind Kubernetes + Flux (./startmvp.sh)
INFRA_MODE=simulation
SIMULATION_MODE=true

OPENSTACK_MODE=mock
CEPH_MODE=mock
GENESTACK_MODE=mock

# --- AI provider -----------------------------------------------------------
# mock = deterministic templates, no external service required.
LLM_PROVIDER=mock
LLM_BASE_URL=http://host.docker.internal:11434
LLM_MODEL=qwen3:8b
LLM_API_KEY=

# --- openCenter ------------------------------------------------------------
# mock   = in-process simulated openCenter (default)
# compat = MVP: the same contract, driven against real Kubernetes + Flux
# real   = a real openCenter API (the bundled mock-opencenter container speaks
#          this contract, so you can try the real code path locally)
OPEN_CENTER_MODE=mock
OPEN_CENTER_URL=http://mock-opencenter:8080
OPEN_CENTER_TOKEN=

# --- policy ----------------------------------------------------------------
# internal = the Python rules only
# opa      = the Python rules plus the rego policies in policies/rego
POLICY_ENGINE=opa
OPA_URL=http://opa:8181
OPA_PACKAGE=aiinfra/authz

# --- persistence -----------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://gpuinfra:gpuinfra@postgres:5432/gpuinfra
POSTGRES_USER=gpuinfra
POSTGRES_PASSWORD=gpuinfra
POSTGRES_DB=gpuinfra
REDIS_URL=redis://redis:6379

# --- authentication (POC only) ---------------------------------------------
# POC ONLY -- DO NOT USE THESE CREDENTIALS IN PRODUCTION.
AUTH_ENABLED=true
AUTH_USERNAME=admin
AUTH_PASSWORD=admin
AUTH_SECRET=poc-insecure-signing-key

# --- ports -----------------------------------------------------------------
FRONTEND_PORT=3000
BACKEND_PORT=8000
GRAFANA_PORT=3001
PROMETHEUS_PORT=9090
OPA_PORT=8181
OPENCENTER_PORT=8080

# --- observability ---------------------------------------------------------
PROMETHEUS_ENABLED=true
GRAFANA_ENABLED=true
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin

# --- pacing ----------------------------------------------------------------
# Seconds between simulated openCenter pipeline steps (0 = instant).
DEPLOY_STEP_SECONDS=1.2
METRICS_INTERVAL_SECONDS=5
LOG_LEVEL=INFO

# --- MVP (kind) ------------------------------------------------------------
KIND_CLUSTER_NAME=gpu-native-mvp
KIND_WORKERS=2
GITOPS_BRANCH=main
# Left empty: the MVP commits to a local GitOps working tree.
GITOPS_REMOTE_URL=

# --- real infrastructure (leave empty for the POC) -------------------------
# Never commit real credentials. Use environment variables or Docker secrets.
KUBECONFIG=
KUBERNETES_CONTEXT=
OS_AUTH_URL=
OS_USERNAME=
OS_PASSWORD=
OS_PROJECT_NAME=
CEPH_DASHBOARD_URL=
PROMETHEUS_URL=
